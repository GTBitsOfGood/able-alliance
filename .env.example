# Docker Compose defaults; use localhost URLs when running services on the host.
DATABASE_URL=postgresql://able:able@postgres:5432/able_alliance
WATCHPACK_POLLING=true

# NextAuth
NEXTAUTH_SECRET=dev-secret-change-in-production
AUTH_TRUST_HOST=true
DEPLOY_PRIME_URL=http://localhost:3000
# Server-to-server URL for the websocket server to reach the Next.js app
APP_INTERNAL_URL=http://app:3000

# CAS Authentication
# Server-to-server CAS URL
CAS_BASE_URL=http://cas:8443/cas
# Browser-facing URL (used for login redirects visible to the user)
CAS_BASE_URL_BROWSER=http://localhost:8443/cas

# Juno (email / API)
JUNO_API_KEY=your-juno-api-key
JUNO_BASE_URL=your-juno-url
JUNO_EMAIL_SENDER_EMAIL=bitsgood85@gmail.com
JUNO_EMAIL_SENDER_NAME=Able Alliance

# WebSocket server for real-time chat and toast notifications
NEXT_PUBLIC_WS_URL=http://localhost:4000
# Server-to-server URL for the Next.js app to reach the websocket server
WEBSOCKET_INTERNAL_URL=http://websocket:4000
# Shared secret authorizing the Next.js app to push notifications via the
# websocket server's internal /notify endpoint. Must match the value the
# websocket server is started with.
WEBSOCKET_INTERNAL_SECRET=dev-internal-secret-change-in-production

NEXT_PUBLIC_MAPBOX_TOKEN="put token here"

# Server-side Mapbox secret token (sk.) — directions:read scope only. Never expose to browser.
MAPBOX_TOKEN="put secret token here"
